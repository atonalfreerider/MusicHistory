        }
      ]
    },
    {
      "id": "doors-arrive",
      "anchor": {
        "segment": 1,
        "offset": 2.1
      },
      "kind": "changeover",
      "text": "Here Without You sings over Jackson's band. Brad Arnold wrote it about missing someone on tour, and meant it as a happy song.",
      "image": "artist-Q175097",
      "sources": [
        {
          "title": "Here Without You (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/Here_Without_You"
        }
      ]
    },
    {
      "id": "lmfao-arrives",
      "anchor": {
        "segment": 4,
        "offset": 2.1
      },
      "kind": "changeover",
      "text": "Party Rock Anthem now rides Three Doors Down's band. It loops minor, flat seven, flat six.",
      "image": "artist-Q48978",
      "sources": [
        {
          "title": "Party Rock Anthem (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/Party_Rock_Anthem"
