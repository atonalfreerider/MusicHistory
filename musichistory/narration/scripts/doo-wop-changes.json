{
  "id": "doo-wop-changes",
  "title": "Doo-wop changes",
  "cues": [
    {
      "id": "intro",
      "anchor": {
        "segment": 0,
        "offset": 0.3
      },
      "kind": "intro",
      "text": "Doo-wop changes. Paul Anka was sixteen when he wrote and recorded Diana in nineteen fifty-seven. It rides the fifties progression: one, six minor, four, five.",
      "image": "artist-Q216563",
      "sources": [
        {
          "title": "Diana (Paul Anka song) (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/Diana_(Paul_Anka_song)"
        },
        {
          "title": "'50s progression (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/%2750s_progression"
        }
      ]
    },
    {
      "id": "last-kiss-arrives",
      "anchor": {
        "segment": 1,
        "offset": 2.2
      },
      "kind": "changeover",
      "text": "Last Kiss now sings over Anka's band, lifted into his key. The same four chords carry it.",
      "image": null,
      "sources": [
        {
          "title": "Pearl Jam, Last Kiss (cover of the same song) (Hooktheory TheoryTab, chords)",
          "url": "https://www.hooktheory.com/theorytab/view/pearl-jam/last-kiss"
        },
        {
          "title": "'50s progression (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/%2750s_progression"
        }
      ]
    },
    {
      "id": "last-kiss",
      "anchor": {
        "segment": 1,
        "offset": 10.4
      },
      "kind": "song",
      "text": "Wayne Cochran first recorded it in nineteen sixty-one. J. Frank Wilson and the Cavaliers took it to number two three years later.",
      "image": null,
      "sources": [
        {
          "title": "Last Kiss (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/Last_Kiss"
        }
      ]
    },
    {
      "id": "coldplay-arrives",
      "anchor": {
        "segment": 3,
        "offset": 2.2
      },
      "kind": "changeover",
      "text": "Coldplay's Viva la Vida now sings over the Cavaliers' band. Chris Martin found the melody in about ten minutes.",
      "image": "artist-Q45188",
      "sources": [
        {
          "title": "Viva la Vida (song) (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/Viva_la_Vida_(song)"
        }
      ]
    },
    {
      "id": "viva-la-vida",
      "anchor": {
        "segment": 3,
        "offset": 11.6
      },
      "kind": "song",
      "text": "Its loop is the fifties progression rotated: four, five, one, six minor. Strings and a church bell drive it.",
      "image": "artist-Q45188",
      "sources": [
        {
          "title": "Viva la Vida (song) (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/Viva_la_Vida_(song)"
        },
        {
          "title": "Coldplay, Viva la Vida (Hooktheory TheoryTab, chords)",
          "url": "https://www.hooktheory.com/theorytab/view/coldplay/viva-la-vida"
        },
        {
          "title": "'50s progression (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/%2750s_progression"
        }
      ]
    },
    {
      "id": "outro",
      "anchor": {
        "segment": 4,
        "offset": 1.9
      },
      "kind": "outro",
      "text": "The title came from a Frida Kahlo painting. Fifty-one years after Diana, the same changes still turn.",
      "image": "artist-Q45188",
      "sources": [
        {
          "title": "Viva la Vida (song) (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/Viva_la_Vida_(song)"
        },
        {
          "title": "'50s progression (Wikipedia)",
          "url": "https://en.wikipedia.org/wiki/%2750s_progression"
        }
      ]
    }
  ]
}
