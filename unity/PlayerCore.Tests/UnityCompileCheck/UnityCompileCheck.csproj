<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Proves the Unity layer compiles without opening Unity: SongPlayer.cs + Core/*.cs + the
    ISongPlayer contract, as C# 9, against Unity's own netstandard 2.1 reference assembly and
    the editor's UnityEngine.CoreModule / AudioModule, warnings as errors.
    dotnet build unity/PlayerCore.Tests/UnityCompileCheck [-p:UnityEditorData="...\Editor\Data"]
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityEditorData Condition="'$(UnityEditorData)' == ''">C:\Program Files\Unity\Hub\Editor\6000.6.3f1\Editor\Data</UnityEditorData>
    <AssetsDir>$(MSBuildThisFileDirectory)..\..\Assets</AssetsDir>
    <AudioDir Condition="'$(AudioDir)' == ''">$(AssetsDir)\MusicHistory\Audio</AudioDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AudioDir)\**\*.cs" />
    <Compile Include="$(AssetsDir)\MusicHistory\Contracts\ISongPlayer.cs" />
    <Reference Include="netstandard"><HintPath>$(UnityEditorData)\NetStandard\ref\2.1.0\netstandard.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityEditorData)\Managed\UnityEngine\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(UnityEditorData)\Managed\UnityEngine\UnityEngine.AudioModule.dll</HintPath></Reference>
    <Reference Include="MeltySynth"><HintPath>$(AssetsDir)\Plugins\MeltySynth\MeltySynth.dll</HintPath></Reference>
    <Reference Include="NAudio.Midi"><HintPath>$(AssetsDir)\Plugins\NAudio\NAudio.Midi.dll</HintPath></Reference>
    <Reference Include="NAudio.Core"><HintPath>$(AssetsDir)\Plugins\NAudio\NAudio.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>
