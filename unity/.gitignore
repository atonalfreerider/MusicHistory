# Unity project nested inside the MusicHistory repo. Patterns starting with "/" are
# anchored to this folder (unity/), not to the repository root.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/

# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# TextMesh Pro essentials ARE committed here (a fresh clone must render labels).

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / solution files (regenerated by the editor)
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and builds
sysinfo.txt
*.apk
*.unitypackage
crashlytics-build.properties

# A graph DB copied next to a player build (the pipeline writes data/graph/ instead)
Assets/StreamingAssets/*.db
Assets/StreamingAssets/*.db.meta
